{
  "name": "bob-config-importer",
  "displayName": "Bob Config Importer (Community)",
  "description": "Unofficial community importer: browse, preview, and install curated Bob modes, skills, and MCP configurations from any bob_config_collection (GitHub, bundled, or local) into your workspace's .bob/ folder. Not affiliated with or supported by IBM.",
  "version": "0.1.0",
  "publisher": "thomassuedbroecker",
  "license": "Apache-2.0",
  "icon": "images/icon-color.png",
  "galleryBanner": {
    "color": "#0d3b3f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thomassuedbroecker/review_and_sdd_custom_ibm_bob_configuration_template.git",
    "directory": "bob_config_collection/code"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "IBM Bob",
    "community",
    "custom modes",
    "custom skills",
    "architecture review",
    "spec-driven development"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bob-config-importer",
          "title": "Bob Config Importer",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "bob-config-importer": [
        {
          "id": "bobConfigImporter.mainView",
          "name": "Bob Config Importer",
          "type": "webview",
          "icon": "images/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "bobConfigImporter.browseDocs",
        "title": "Read Mode or Skill Documentation…",
        "category": "Bob Config"
      },
      {
        "command": "bobConfigImporter.importModes",
        "title": "Import Modes…",
        "category": "Bob Config"
      },
      {
        "command": "bobConfigImporter.importSkills",
        "title": "Import Skills…",
        "category": "Bob Config"
      },
      {
        "command": "bobConfigImporter.importOther",
        "title": "Import Other Configurations…",
        "category": "Bob Config"
      },
      {
        "command": "bobConfigImporter.importGroup",
        "title": "Import Complete Mode Group…",
        "category": "Bob Config"
      },
      {
        "command": "bobConfigImporter.selectSource",
        "title": "Select Collection Source…",
        "category": "Bob Config"
      },
      {
        "command": "bobConfigImporter.refreshCollection",
        "title": "Refresh Collection",
        "category": "Bob Config"
      }
    ],
    "configuration": {
      "title": "Bob Config Importer",
      "properties": {
        "bobConfigImporter.source": {
          "type": "string",
          "enum": [
            "github",
            "bundled",
            "local"
          ],
          "enumDescriptions": [
            "Download the collection from a public GitHub repository (latest).",
            "Use the collection packaged into this extension version (offline).",
            "Use a bob_config_collection folder on disk."
          ],
          "default": "github",
          "description": "Where modes, skills, and other configurations are imported from."
        },
        "bobConfigImporter.githubRepository": {
          "type": "string",
          "default": "thomassuedbroecker/review_and_sdd_custom_ibm_bob_configuration_template",
          "description": "Public GitHub repository (owner/name) that contains the collection. Point this at your own repository created from the template."
        },
        "bobConfigImporter.githubRef": {
          "type": "string",
          "default": "main",
          "description": "Branch, tag, or commit SHA to import from."
        },
        "bobConfigImporter.githubCollectionPath": {
          "type": "string",
          "default": "bob_config_collection",
          "description": "Folder inside the repository that contains modes/ and skills/."
        },
        "bobConfigImporter.localCollectionPath": {
          "type": "string",
          "default": "",
          "description": "Collection folder for source 'local': absolute, or relative to the first workspace folder (default: bob_config_collection)."
        }
      }
    }
  },
  "scripts": {
    "build": "node src/tools/build.js",
    "icon": "node src/tools/render-icon.js",
    "test": "node --test test/*.test.js",
    "package": "npm run build && vsce package --out dist/",
    "sync:template": "node src/tools/sync-workspace.js --target ../..",
    "sync:check": "node src/tools/sync-workspace.js --target ../.. --check"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "sharp": "^0.35.5"
  }
}
